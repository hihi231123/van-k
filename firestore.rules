rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "glebopyx@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /returns/{returnId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(["amount", "note", "createdAt", "createdBy"])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update, delete: if false;
    }

    match /additions/{additionId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(["amount", "note", "createdAt", "createdBy"])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update, delete: if false;
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update: if isOwner()
        && contentId == "dailyPhoto"
        && request.resource.data.keys().hasOnly(["imageData", "caption", "updatedAt", "updatedBy"])
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 850000
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 120
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isOwner();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "text", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 32
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}